# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/_posts/test-*
/_recipes/test-*

# playwright run output — the baselines under tests/visual/__screenshots__
# are committed, everything a run produces is not
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# generated at build time (prebuild)
/public/sitemap.xml
/util/nav.generated.json

# production
/build

# agent worktrees — checkouts an agent session creates to work on a branch in
# isolation. They are working directories, not content: each one is a full
# second copy of the repo whose real output arrives as a commit on its own
# branch. Committing them would nest the repository inside itself.
/.claude/worktrees/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel
